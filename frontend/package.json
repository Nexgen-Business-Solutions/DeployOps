{
  "name": "deployops-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/deployops/frontend/ && yarn copy-html-entry",
    "lint": "oxlint",
    "preview": "vite preview",
    "copy-html-entry": "cp ../deployops/public/frontend/index.html ../deployops/www/deployops.html",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
